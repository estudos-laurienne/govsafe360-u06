{
  "name": "govsafe360-laboratorio",
  "private": true,
  "type": "module",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "report:e2e": "playwright show-report evidencias/relatorio-html",
    "check:js": "node --check js/app.js && node --check js/politica.js && node --check tools/govsafe-mcp.mjs",
    "build": "node scripts/sincronizar-publicacao.mjs",
    "check:sync": "node scripts/verificar-sincronia.mjs",
    "test:policy": "node scripts/testar-politica.mjs",
    "test:mcp": "node tools/teste-mcp.mjs",
    "quality": "npm run check:js && npm run build && npm run check:sync && npm run test:policy && npm run test:mcp"
  },
  "devDependencies": {
    "@playwright/test": "1.56.0"
  },
  "version": "1.6.0",
  "engines": {
    "node": ">=20.11.0"
  }
}
